entity BoardGameAdminV2 {

  id String
  gameId Integer required
  englishName String required
  chineseName String required
  totalTime Integer
  averageTimePerPlayer Integer
  primaryLanguage String
  category String
  themes String
  mode String
  boxUrl String
  coverUrl String
  status String
  difficulty Integer
  publishYear Integer

  gameHotnessValue Double
  wemeetRating Double
  gstoneRating Double
}
