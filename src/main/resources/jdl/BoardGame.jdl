entity BoardGameAdminV2 {

  id String
  gameId Integer
  englishName String required
  chineseName String
  totalTime Integer
  averageTimePerPlayer Integer
  primaryLanguage String
  category String
  themes String
  mode String
  boxUrl String
  coverUrl String
  status String
  difficulty Integer
  publishYear Integer

  minPlayers Integer
  maxPlayers Integer
  gameHotnessValue Double
  wemeetRating Double
  gstoneRating Double
  createdAt ZonedDateTime
  updatedAt ZonedDateTime
}
