entity BoardGameAdminV2 {
  gameId Long
  englishName String required
  chineseName String
  totalTime Integer
  averageTimePerPlayer Integer
  primaryLanguage String
  themes String
  mode String
  boxUrl String
  coverUrl String
  status String
  difficulty Integer
  publishYear Integer
  playerNums Integer
  minPlayers Integer
  maxPlayers Integer
  gameHotnessValue Double
  wemeetRating Double
  gstoneRating Double
  createdAt ZonedDateTime
  updatedAt ZonedDateTime
}

entity Category {
  id Long
  name String
}

relationship OneToMany {
  BoardGameAdminV2{categories} to Category
}
