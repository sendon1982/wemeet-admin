<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <layout class="ch.qos.logback.classic.PatternLayout">
        <Pattern>
            [%d{yyyy-MM-dd HH:mm:ss.SSS}] %highlight([%level]) %cyan([%logger{36} %file:%line]) - %msg%n
        </Pattern>
        </layout>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
